SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Optional. Used once, only when the feeds table is empty. Leave blank for a manual admin add.
SEED_RTSP_URL=
SEED_FEED_NAME=Kitten Cam
# How often the camera worker disconnects and opens the stream again. 900 is 15 minutes. 0 disables it.
STREAM_RESTART_SECONDS=900
